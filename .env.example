# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL=postgres://reservation:reservation@localhost:5432/reservation

# The organisation's local time zone, as a fixed UTC offset in minutes.
# Sri Lanka = UTC+05:30 = 330 (no daylight saving, so a fixed offset is safe).
APP_UTC_OFFSET_MINUTES=330
NEXT_PUBLIC_UTC_OFFSET_MINUTES=330
