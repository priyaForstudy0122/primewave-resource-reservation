// Paste this into https://dbdiagram.io (Import -> DBML) to get a shareable ER diagram link.

Table resource_types {
  id int [pk, increment]
  name text [not null, unique]
  description text
}

Table resources {
  id int [pk, increment]
  type_id int [not null, ref: > resource_types.id]
  name text [not null, unique]
  location text
  description text
  capacity int [not null, default: 1]
  open_time time [not null, default: '08:00']
  close_time time [not null, default: '18:00']
  max_duration_minutes int [not null, default: 480]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table users {
  id int [pk, increment]
  name text [not null]
  email text [not null, note: 'unique on lower(email)']
  team text
  created_at timestamptz [not null, default: `now()`]
}

Table reservations {
  id int [pk, increment]
  resource_id int [not null, ref: > resources.id]
  user_id int [not null, ref: > users.id]
  title text [not null]
  notes text
  attendees int [not null, default: 1]
  start_time timestamptz [not null]
  end_time timestamptz [not null]
  status text [not null, default: 'confirmed', note: "'confirmed' | 'cancelled'"]
  cancelled_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'EXCLUDE USING gist (resource_id WITH =, tstzrange(start_time, end_time, [)) WITH &&) WHERE status = confirmed -> no overlapping bookings'
}

Table reservation_events {
  id int [pk, increment]
  reservation_id int [not null, ref: > reservations.id]
  event_type text [not null, note: "'created' | 'cancelled'"]
  detail text
  created_at timestamptz [not null, default: `now()`]
}
